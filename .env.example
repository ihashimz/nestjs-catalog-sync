# Copy to .env and supply your own values. Never commit .env.
DATABASE_URL=postgresql://catalog:REPLACE_ME@localhost:5432/catalog
POSTGRES_USER=catalog
POSTGRES_DB=catalog
POSTGRES_PASSWORD=REPLACE_ME
REDIS_HOST=localhost
REDIS_PORT=6379
# Minimum 32 characters, generated locally.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PORT=3000
WORKER_HEALTH_PORT=3001
SWAGGER_ENABLED=true
# Optional supplier: HTTPS endpoint, operator owned. Empty disables the schedule.
SUPPLIER_URL=
SUPPLIER_SOURCE=configured-supplier
SUPPLIER_TOKEN=
# Seed identities explicitly through npm run seed; supply password at command time.
SEED_EMAIL=manager@example.test
SEED_ROLE=manager
